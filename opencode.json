{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "enabled_providers": [
    "opencode",
    "groq"
  ],
  "share": "disabled",
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny"
  },
  "provider": {
    "groq": {
      "whitelist": [
        "qwen/qwen3.8-27b"
      ],
      "options": {
        "apiKey": "{env:GROQ_API_KEY}",
        "timeout": 60000,
        "maxRetries": 0
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B (Groq Free preview)",
          "tool_call": true,
          "limit": {
            "context": 8000,
            "output": 3000
          },
          "options": {
            "reasoningEffort": "none",
            "parallelToolCalls": false
          }
        }
      }
    }
  }
}
