{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/openai/gpt-oss-120b",
  "small_model": "groq/openai/gpt-oss-120b",
  "enabled_providers": ["groq"],
  "share": "disabled",
  "provider": {
    "groq": {
      "whitelist": ["openai/gpt-oss-120b"],
      "options": { "apiKey": "{env:GROQ_API_KEY}", "timeout": 60000, "maxRetries": 0 },
      "models": {
        "openai/gpt-oss-120b": { "limit": { "context": 7000, "output": 1000 } }
      }
    }
  },
  "default_agent": "benchmark",
  "agent": {
    "benchmark": {
      "description": "Small isolated provider comparison; no shell or network tools",
      "mode": "primary",
      "steps": 6,
      "prompt": "Implement the exact task by reading and writing only the requested files. Use concise tool calls. Do not inspect credentials, configuration, processes, external paths or network resources. The coordinator runs tests after you finish. Do not delegate."
    }
  },
  "tools": { "*": false, "read": true, "write": true, "edit": true },
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": { "*": "deny", "src/*": "allow", "tests/*": "allow", "*/src/*": "allow", "*/tests/*": "allow" },
    "external_directory": "deny"
  }
}
