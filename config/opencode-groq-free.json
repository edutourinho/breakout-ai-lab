{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/qwen/qwen3.8-27b",
  "small_model": "groq/qwen/qwen3.8-27b",
  "enabled_providers": ["groq"],
  "share": "disabled",
  "provider": {
    "groq": {
      "whitelist": ["qwen/qwen3.8-27b"],
      "options": { "apiKey": "{env:GROQ_API_KEY}", "timeout": 60000, "maxRetries": 0 },
      "models": {
        "qwen/qwen3.8-27b": { "name": "Qwen 3.8 27B (Groq Free preview)", "tool_call": true, "limit": { "context": 8000, "output": 3000 }, "options": { "reasoningEffort": "none", "parallelToolCalls": false } }
      }
    }
  },
  "default_agent": "benchmark",
  "agent": {
    "benchmark": {
      "description": "Small isolated provider comparison; no shell or network tools",
      "mode": "primary",
      "steps": 6,
      "prompt": "Create the two requested files with the write tool, using the exact absolute paths provided in the task. Read AGENTS.md if needed. Do not inspect credentials, configuration, processes, external paths or network resources. The coordinator runs tests after you finish. Do not delegate."
    }
  },
  "tools": { "*": false, "read": true, "write": true, "edit": true },
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": { "*": "deny", "src/*": "allow", "tests/*": "allow", "*/src/*": "allow", "*/tests/*": "allow" },
    "external_directory": "deny"
  }
}
